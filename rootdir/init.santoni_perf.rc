# Santoni 2GB RAM Base Tuning + Spectrum Activation
# V13: Default Balance (0), added memory tunables per profile

on property:sys.boot_completed=1
    # Base VM tuning (Spectrum profiles will override these)
    write /proc/sys/vm/swappiness 80
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/vfs_cache_pressure 100
    write /proc/sys/vm/extra_free_kbytes 24300

    # Default I/O scheduler
    write /sys/block/mmcblk0/queue/scheduler bfq
    write /sys/block/mmcblk0/queue/read_ahead_kb 128

    # Disable readahead for zRAM
    write /sys/block/zram0/queue/read_ahead_kb 0

    # V13: Default profile = Balance (0)
    setprop persist.sys.spectrum.profile ""
    setprop persist.sys.spectrum.profile 0

on early-init
    setprop persist.sys.spectrum.kernel 1
