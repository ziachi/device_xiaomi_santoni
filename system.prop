#system.prop for msm8937

# Audio
audio.offload.disable=false
vendor.fastrpc.disable.adsprpcd_sensorspd.daemon=1

# Bluetooth
persist.vendor.btstack.a2dp_offload_cap=sbc-aptx-aptxtws-aptxhd-aac-ldac-aptxadaptive

# Boot
sys.vendor.shutdown.waittime=500

# BPF
ro.kernel.ebpf.supported=true

# Camera
media.camera.ts.monotonic=1
persist.camera.gyro.android=0
persist.camera.gyro.disable=1
persist.camera.imglib.cac3=2
persist.camera.isp.clock.optmz=0
persist.camera.HAL3.enabled=1
persist.camera.mct.debug=0
persist.camera.iface.logs=0
persist.camera.imglib.logs=0
persist.camera.isp.debug=0
persist.camera.sensor.debug=0

# Charger
ro.charger.disable_init_blank=true
ro.charger.enable_suspend=true

# Disable Surface Blur
persist.sys.sf.disable_blurs=1

# Disable MTE Async for system server
arm64.memtag.process.system_server=off

# Display
debug.hwui.renderer=skiagl
ro.hwui.render_ahead=20
debug.hwui.skia_atrace_enabled=false
debug.renderengine.backend=skiaglthreaded
persist.demo.hdmirotationlock=false
persist.debug.wfd.enable=1
persist.hwc.enable_vds=1
persist.hwc.mdpcomp.enable=true
renderthread.skia.reduceopstasksplitting=true
ro.qualcomm.cabl=0
ro.qualcomm.svi=0
sdm.debug.disable_skip_validate=1

# DPM
persist.vendor.dpm.feature=0

# Fingerprint
persist.qfp=false
fingerprint.nocleanup=true

# FM
ro.fm.transmitter=false

# GPS
persist.gps.qc_nlp_in_use=1
persist.loc.nlp_name=com.qualcomm.location
ro.gps.agps_provider=1

# Hint Manager
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=30

# Iorapd
ro.iorapd.enable=false
iorapd.perfetto.enable=false
iorapd.readahead.enable=false
persist.device_config.runtime_native_boot.iorap_readahead_enable=false

# Logs
persist.log.tag.AnalyticsService=S
persist.log.tag.KernelCpuUidActiveTimeReader=S
persist.log.tag.Tracer=S
persist.log.tag.NearbySharing=S
persist.log.tag.IntervalStats=S
persist.log.tag.CompatibilityChangeReporter=S
persist.log.tag.SQLiteLog=S
persist.log.tag.wificond=S
persist.log.tag.b/223498680=S
persist.log.tag.TrafficStats=S
persist.log.tag.ContrastColorUtil=S

# Media
media.aac_51_output_enabled=true
media.msm8956hw=0
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
media.stagefright.audio.sink=280
media.wfd.max_resolution=6
mm.enable.smoothstreaming=true
mmp.enable.3g2=true
vendor.mm.enable.qcom_parser=1048575
vendor.video.disable.ubwc=1

# Perf-config
ro.vendor.qti.sys.fw.bservice_age=5000
ro.vendor.qti.sys.fw.bservice_limit=5
ro.vendor.qti.sys.fw.bservice_enable=true
ro.vendor.qti.sys.fw.use_trim_settings=true
ro.vendor.qti.sys.fw.empty_app_percent=50
ro.vendor.qti.sys.fw.trim_empty_percent=100
ro.vendor.qti.sys.fw.trim_cache_percent=100
ro.vendor.qti.sys.fw.trim_enable_memory=2147483648
ro.vendor.qti.am.reschedule_service=true
ro.vendor.at_library=libqti-at.so
vendor.debug.enable.lm=true
ro.lmk.enable_userspace_lmk=false
vendor.perf.gestureflingboost.enable=true

# QC framework value-adds
ro.vendor.qti.va_aosp.support=1

# Radio (IMS)
service.qti.ims.enabled=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugDataPathLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableSigHandler=1
persist.vendor.ims.disableQXDMLogs=1

# Render
debug.cpurend.vsync=false

# ScalarConfig
vendor.display.disable_scaler=1

# Seamless transfer
sys.fflag.override.settings_seamless_transfer=true

# Skia

# SurfaceFlinger
ro.surface_flinger.protected_contents=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.vsync_event_phase_offset_ns=2000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=6000000

# Telephony
DEVICE_PROVISIONED=1
persist.rild.nitz_long_ons_0=
persist.rild.nitz_long_ons_1=
persist.rild.nitz_long_ons_2=
persist.rild.nitz_long_ons_3=
persist.rild.nitz_plmn=
persist.rild.nitz_short_ons_0=
persist.rild.nitz_short_ons_1=
persist.rild.nitz_short_ons_2=
persist.rild.nitz_short_ons_3=
rild.libargs=-d /dev/smd0
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so
ril.subscription.types=NV,RUIM
ro.telephony.call_ring.multiple=false
ro.telephony.default_network=22,22
telephony.lteOnCdmaDevice=1

# Time
persist.backup.ntpServer=0.pool.ntp.org
persist.timed.enable=true

# Watchdog
ro.hw_timeout_multiplier=3

# WiFi Display
persist.sys.wfd.virtual=0

# Zygote
zygote.critical_window.minute=10

# ========================
# Performance Tuning (2GB)
# ========================
# Faster app launch
persist.device_config.runtime_native.usap_pool_enabled=false
# Reduce background process limit  
ro.sys.fw.bg_apps_limit=6
# Aggressive cached app compaction
persist.sys.appcompact.enable_app_compact=true
persist.sys.appcompact.full_compact_type=2
# Reduce window animation scale
persist.sys.animator_duration_scale=0.5

# Disable flags_health_check crash loop (suppresses 245+ resets)
persist.device_config.configuration.disable_server_configurable_flags_reset=true

# Spectrum Kernel Manager
persist.spectrum.kernel=1
persist.spectrum.profile=0

# v4 Fix #14: Disable Settings Intelligence (5K spam lines, CPU waste)
persist.log.tag.SettingsIntelligence=S
persist.log.tag.com.google.android.settings.intelligence=S

# v4 Fix #17: Disable Google adservices (saves ~10MB RAM)
persist.device_config.adservices.enabled=false
persist.device_config.adservices.measurement_kill_switch=true
persist.device_config.adservices.topics_kill_switch=true
persist.device_config.adservices.fledge_kill_switch=true

# v4 Fix #18: Reduce GMS background activity (95 GC/5min in logcat)
# Limit GMS chimera scheduled tasks
ro.com.google.gmsversion=15_202501
# Restrict background GMS wakeups
persist.device_config.gms_games.enabled=false
# Limit GCM wakeups

# v5 Fix #25: GMS memory & background limiter for 2GB RAM
# Limit max cached processes system-wide
persist.device_config.activity_manager.max_cached_processes=8
# Defer dex2oat to idle/charging state to reduce first boot lag
pm.dexopt.install=speed-profile
pm.dexopt.bg-dexopt=speed-profile
pm.dexopt.boot-after-ota=verify
pm.dexopt.first-boot=verify
# Limit GMS background service restarts
persist.log.tag.gs.intelligence=S
persist.log.tag.AccessPersistence=S
persist.log.tag.BluetoothPowerStatsCollector=S

# ========================
# [v10] GApps Boot Optimization
# ========================
# Dalvik VM heap for 2GB RAM with GApps

# More aggressive LMK for 2GB + GApps
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.downgrade_pressure=100
ro.lmk.kill_heaviest_task=true
ro.lmk.use_minfree_levels=true

# Limit GMS background services (reduce ANR cascade)
persist.sys.fw.bg_apps_limit=6

# Speed up first boot — skip GMS setup wizard delays
ro.setupwizard.mode=OPTIONAL

# Reduce dex2oat threads on first boot (prevent ANR from CPU starvation)
dalvik.vm.dex2oat-threads=2
dalvik.vm.boot-dex2oat-threads=4
dalvik.vm.image-dex2oat-threads=4

# ========================
# [v10] Log Suppression — cosmetic errors
# ========================
# QTI PowerHAL vendor blob spam (17804x — no source fix)
persist.log.tag.QTI PowerHAL=S

# WiFi getCachedScanData (HAL returns NOT_SUPPORTED, working as designed)
persist.log.tag.WifiStaIfaceAidlImpl=S

# TaskPersister (cosmetic, dir created on first write by system_server)
persist.log.tag.TaskPersister=S

# FastChargingPreferenceController (no fast charge HW on santoni)
persist.log.tag.FastChargingPreferenceController=S

# ClockRegistry JSON parse (null settings on first boot)
persist.log.tag.ClockRegistry (System)=S

# OverviewProxyService dead object (SystemUI reconnect after ANR)
persist.log.tag.OverviewProxyService=S

# SharedConnectivityManager (GMS service binding)
persist.log.tag.SharedConnectivityManager=S

# InputDispatcher hover events (wallpaper channel cosmetic)
persist.log.tag.InputDispatcher=S

# SmsApplication self-healing permissions
persist.log.tag.SmsApplication=S

# AppOpService migration noise
persist.log.tag.AppOpService=S

# GMS internal noise
persist.log.tag.Finsky=S
persist.log.tag.gogt=S
persist.log.tag.ChimeraSrvcProxy=S
persist.log.tag.constellation=S
persist.log.tag.RestoreGrpcBackupOptInA=S

# DeviceBasedSatelliteRepo (no satellite HW)
persist.log.tag.DeviceBasedSatelliteRepo=S

# FileSystemUtils fallocate (kernel 4.9 limitation)
persist.log.tag.FileSystemUtils=S

# ========================
# [v11] GMS RAM Reduction — Play Integrity + Play Store only
# ========================
# Prevent GMS background auto-updates
persist.device_config.gms.auto_update=false
# Disable USAP pre-fork pool (saves ~30MB RAM)
persist.sys.usap_pool_enabled=false
# Disable Smart Selection / App Prediction (saves ~20MB)
persist.device_config.activity_manager_native_boot.offload_queue_enabled=false
ro.launcher.live_wallpaper=0
# Restrict GMS chimera background scheduling
persist.device_config.gservices_android.enabled=false
# Disable ambient display (saves background sensor polling)
ro.config.always_show_time=false

# V12: Suppress known harmless log spam
persist.log.tag.RkpdWidevine=S
persist.log.tag.TaskbarDelegate=S
persist.log.tag.hwservicemanager=S

# V12: Disable Android bloat background services (~75MB RAM saved)
# Google Ads tracking - not needed
ro.com.google.gms.adservices.enable=false

# Google federated ML training - not needed
ro.com.google.gms.federatedcompute.enable=false

# Google on-device personalization (ads) - not needed  
ro.com.google.gms.ondevicepersonalization.enable=false

# Android Enterprise device lock - not needed for personal device
ro.com.google.gms.devicelockcontroller.enable=false

# Disable auto-sync by default (user can enable per-account)
ro.config.sync=no

# V16: Disable cached app freezer — kernel 4.9 no cgroup v2 freezer support
persist.device_config.activity_manager_native_boot.use_freezer=false
